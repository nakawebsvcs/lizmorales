/* Tablet - 768px - Reset mobile ordering and restore desktop layout */
@media only screen and (min-width: 48rem) {
  #gallery-1716 {
    .cs-container {
      flex-direction: column;
      align-items: center;
    }

    .cs-content {
      max-width: (800/16rem);
      margin-bottom: (32/16rem);
    }

    .cs-gallery {
      gap: 2rem;
    }

    .cs-picture {
      width: calc(33.333% - 1.33rem);
      max-width: (220/16rem);
      
      &:hover {
        transform: translateY(-12px) scale(1.03);
      }
    }

    &:before {
      height: 33%;
    }

    .lightbox-content {
      max-width: 800px;
      max-height: 85vh;
    }

    .lightbox-close {
      top: 1.5rem;
      right: 1.5rem;
      width: 45px;
      height: 45px;
      font-size: 26px;
    }

    .lightbox-body {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 4rem 2.5rem 2rem 2.5rem;
    }

    .lightbox-main-content {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 2rem;
      align-items: start;
    }

    .lightbox-left-column {
      display: flex; /* Reset from contents */
      flex-direction: column;
      gap: 1rem;
    }

    .lightbox-right-column {
      display: grid; /* Reset from contents */
      grid-template-rows: 1fr auto;
      gap: 1.5rem;
      height: 100%;
      align-items: start;
    }

    .lightbox-image {
      order: unset; /* Reset mobile ordering */
      max-width: none;
    }

       .lightbox-info {
      order: unset; /* Reset mobile ordering */
      flex: 1;
      
      h3 {
        text-align: left;
        font-size: 2.2rem;
