---
import Navbar from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import Discography from '../components/Discography.astro';
import Weddings from '../components/Weddings.astro';
import Schedule from '../components/Schedule.astro';
import Footer from '../components/Footer.astro';
import '../styles/root.less';

// Import images
import aboutImage from '../assets/IMG_4132.jpeg';
---

<Layout>
	<Navbar />

    <Schedule />
    <CTA />
    <Hero />

    <!-- ============================================ -->
<!--                   Gallery                    -->
<!-- ============================================ -->

<section id="gallery-39">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">Favorite snapshots from my recent travels</span>
            <h2 class="cs-title">Highlights</h2>
        </div>
        <div class="cs-image-group">
            <!-- Picture 1 - Left Section -->
            <picture class="cs-picture cs-picture-one">
                <source media="(max-width: 600px)" srcset="/assets/liz-mapu.png">
                <source media="(min-width: 601px)" srcset="/assets/liz-mapu.png">
                <img loading="lazy" decoding="async" src="/assets/liz-mapu.png" alt="Liz and Mapuana" width="752" height="920">
            </picture>
            <!-- Right Section -->
            <div class="cs-flex-group">
                <!-- Picture 2 -->
                <picture class="cs-picture cs-picture-two">
                    <source media="(max-width: 600px)" srcset="/assets/liz-conch.png">
                    <source media="(min-width: 601px)" srcset="/assets/liz-conch.png">
                    <img loading="lazy" decoding="async" src="/assets/liz-conch.png" alt="Liz with Conch" width="595" height="811";>
                </picture>
                <!-- Picture 3 -->
                <picture class="cs-picture cs-picture-three">
                    <source media="(max-width: 600px)" srcset="/assets/liz-cocktail.png">
                    <source media="(min-width: 601px)" srcset="/assets/liz-cocktail.png">
                    <img loading="lazy" decoding="async" src="/assets/liz-cocktail.png" alt="Liz with cocktail" width="501" height="589">
                </picture>
            </div>
        </div>
    </div>
</section>

<Discography />
<Weddings />

<!-- ============================================ -->
<!--             Side By Side Reverse             -->
<!-- ============================================ -->

<section id="sbsr-1011">
    <div class="cs-container">
        <div class="cs-image-group">
            <picture class="cs-picture">
                <!--Desktop-->
                <source media="(min-width: 1024px)" srcset={aboutImage.src}>
                <!--Tablet-->
                <source media="(min-width: 601px)" srcset={aboutImage.src}>
                <!--Mobile-->
                <source media="(max-width: 600px)" srcset={aboutImage.src}>
                <img loading="lazy" decoding="async" src={aboutImage.src} alt="liz morales" width="522" height="461" aria-hidden="true">
            </picture>
        </div>
        <div class="cs-content">
            <span class="cs-topper">Bio</span>
            <h2 class="cs-title">About Liz</h2>
            <p class="cs-text">
                Liz Morales, a respected community leader from Maui, is a multi-talented performer, singer, songwriter, music producer, and educator. She is the founder of the band Ahumanu, which has garnered recognition as a Na Hoku Hanohano Award finalist and Grammy-nominated group since 2003. Ahumanu has captivated audiences globally, spreading Hawaiian music across various countries such as Tahiti, Rapa Nui, Japan, Korea, and now in Europe. Liz has mastered multiple instruments and music genres through the traditional Hawaiian method of learning, which emphasizes observation and listening over asking questions.
                <!--Creates the space between p tags on mobile-->
                <span class="cs-spacer"></span>
                Her musical journey began when she learned to play the guitar from her father, who encouraged her to watch and listen attentively instead of seeking immediate answers. This approach shaped her into a resourceful and analytical musician who can reproduce desired sounds independently. Music has profoundly influenced Liz's life, and she is enthusiastic about sharing her passion for Hawaiian music with music enthusiasts worldwide.
            </p>
            <button class="cs-button-solid" onclick="openContactForm()">Get in Touch</button>
        </div>
    </div>
</section>

<Footer />
</Layout>
                                
                                

<style lang="less">
/*-- -------------------------- -->
<---          Gallery           -->
<--- -------------------------- -*/

/* Mobile */
@media only screen and (min-width: 0rem) {
    #gallery-39 {
        padding: var(--sectionPadding);
        background-color: #fff;

        .cs-container {
            width: 100%;
            max-width: (1200/16rem);
            margin: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            /* 32px - 48px */
            gap: clamp(2rem, 4vw, 3rem);
        }

        .cs-content {
            /* set text align to left if content needs to be left aligned */
            text-align: center;
            width: 100%;
            display: flex;
            flex-direction: column;
            /* centers content horizontally, set to flex-start to left align */
            align-items: center;
            position: relative;
            z-index: 10;
        }

        .cs-title {
            font-family: 'Allura', cursive;
            font-size: 5rem;
            margin: 0;
            max-width: 25ch;
        }

        .cs-image-group {
            /* scales the whole section down, and grows with the screen width */
            /* bigger vw unit grows it, smaller shrinks it */
            font-size: ~"min(1.2vw, 1em)";
            width: 100%;
            max-width: 100%;
            margin: auto;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            z-index: 1;
        }

        .cs-flex-group {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: flex-start;
        }

        .cs-picture-two {
            margin-bottom: (16/16em);
        }

        .cs-picture {
            display: block;
            position: relative;

            img {
                position: absolute;
                top: 0;
                left: 0;
                height: 100%;
                width: 100%;
                object-fit: cover;
                object-position: 35% 50%;
            }
        }

        .cs-picture-one {
            width: (752/16em);
            height: (920/16em);
            margin-top: (177/16em);
            margin-right: (16/16em);

            &:before {
                /* Color box */
                content: "";
                position: absolute;
                display: block;
                height: (485/16em);
                width: (453/16em);
                background: var(--secondary);
                opacity: 1;
                bottom: (-64/16em);
                left: (-33/16em);
                z-index: -1;
            }
        }

        .cs-picture-two {
            width: (595/16em);
            height: (811/16em);
        }

        .cs-picture-three {
            width: (501/16em);
            height: (589/16em);
        }
    }
}

/* Desktop - 1024px - Keep gallery smaller on desktop */
@media only screen and (min-width: 64rem) {
    #gallery-39 {
        .cs-image-group {
            font-size: ~"min(0.75vw, 0.75em)";
            max-width: (1200/16rem);
        }
    }
}

/*-- -------------------------- -->
<---    Side By Side Reverse    -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
    #sbsr-1011 {
        padding: var(--sectionPadding);
        background-color: var(--primary);

        .cs-container {
            width: 100%;
            /* changes to 1280px at desktop */
            max-width: (800/16rem);
            margin: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            /* 48px - 64px */
            gap: clamp(3rem, 6vw, 4rem);
        }

        .cs-content {
            /* set text align to left if content needs to be left aligned */
            text-align: left;
            width: 100%;
            /* changes to 522px at desktop */
            max-width: (578/16rem);
            margin-top: (-16/16rem);
            display: flex;
            flex-direction: column;
            /* centers content horizontally, set to flex-start to left align */
            align-items: flex-start;
        }

        .cs-title,
        .cs-text {
            color: var(--secondary);
        }

        .cs-title {
            font-family: 'Allura', cursive;
            font-size: clamp(3rem, 6vw, 3.5rem);
            padding: 1rem;
        }

        .cs-text {
            margin-bottom: (16/16rem);
            opacity: 0.8;
            &:last-of-type {
                margin-bottom: (32/16rem);
            }
        }

        .cs-spacer {
            width: 100%;
            /* 16px - 24px */
            height: clamp(1rem, 3vw, 1.5rem);
            display: block;
        }

        .cs-image-group {
            width: 100%;
        }

        .cs-picture {
            width: 100%;
            height: (261/16rem);
            border: 9px solid var(--secondary);
            background-color: #fff;
            display: block;
            box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
            position: relative;

            img {
                position: absolute;
                top: 0;
                left: 0;
                height: 100%;
                width: 100%;
                /* makes it behave like a background image */
                object-fit: cover;
            }
        }

        .cs-seal {
            /* changes to a clamp(104px - 190px) at desktop */
            width: (104/16rem);
            height: auto;
            /* 104px - 190px */
            /* wrapped clamp in calc function to make the value negative, and multiply by half (.5) the height to it always overlaps the bg image by half its height */
            margin-top: ~"calc(clamp(6.5rem, 12vw, 11.875rem)*-.5)";
            margin-left: auto;
            /* 28px - 120px */
            margin-right: clamp(1.75rem, 10vw, 7.5rem);
            background-color: #fff;
            border: clamp(6px, 0.8vw, 12px) solid #fff;
            border-radius: 50%;
            display: block;
            position: relative;
            /* make it rest on top of the bg picture */
            z-index: 10;
        }
    }
}

/* Tablet - 768px */
@media only screen and (min-width: 48rem) {
    #sbsr-1011 {
        .cs-container {
            align-items: flex-start;
        }
        .cs-flex-group {
            flex-direction: row;
        }

        .cs-text {
            columns: 2;
            column-gap: (24/16rem);
        }

        .cs-picture {
            img {
                object-position: center 20%;
            }
        }

        .cs-spacer {
            display: none;
        }
    }
}

/* Small Desktop - 1024px */
@media only screen and (min-width: 64rem) {
    #sbsr-1011 {
        .cs-container {
            max-width: (1280/16rem);
            flex-direction: row;
            justify-content: flex-end;
            align-items: center;
            /* 100px - 200px */
            gap: clamp(6.25rem, 13vw, 12.5rem);
        }

        .cs-image-group {
            max-width: (542/16rem);
            display: flex;
            justify-content: flex-end;
            position: relative;
            /* sends it to the right in the 2nd position */
            order: 2;
        }

        .cs-picture {
            height: (460/16rem);
            aspect-ratio: initial;
        }

        .cs-seal {
            /* 104 - 190px */
            width: clamp(6.5rem, 13vw, 11.875rem);
            margin: 0;
            position: absolute;
            top: 50%;
            /* subtract 12px (.75rem) to account for the border */
            left: ~"calc((clamp(6.5rem, 13vw, 11.875rem)*-.5) + -.75rem)";
            transform: translateY(-50%);
        }

        .cs-content {
            flex: none;
            width: 54%;
            max-width: (542/16rem);
        }
    }
}

</style>
